{
  "PreToolUse": [
    {
      "matcher": "exec|write_to_process",
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PROJECT_DIR/agents/block-random-execs.ts\"",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PROJECT_DIR/agents/stop-after-blocked-tool.ts\"",
          "timeout": 10
        }
      ]
    }
  ]
}
