#!/usr/bin/env bash
# Shared coverage reporter over the Istanbul raw data dev/test collects.
# Use --lcov to emit the machine-checked lcov file, --html for an HTML report
# at coverage/html/index.html; no flag prints a per-file summary.
set -euo pipefail

if [[ "${1:-}" == "--lcov" ]]; then
  exec bun agents/coverage/cli.ts lcov
fi

if [[ "${1:-}" == "--html" ]]; then
  exec bun agents/coverage/cli.ts html
fi

bun agents/coverage/cli.ts
