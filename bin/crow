#!/usr/bin/env -S deno run --allow-read --allow-write --allow-env --allow-net --allow-ffi --allow-run=git --allow-sys=hostname
/** crow — CLI entry point. Delegates to src/cli.ts. */
import { ApplicationData } from '../src/application-data.ts'
import { run } from '../src/cli.ts'

const data = new ApplicationData()

run(data).catch((error) => {
  data.logger().error(error)
  Deno.exit(1)
})
