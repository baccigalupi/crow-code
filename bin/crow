#!/usr/bin/env node
/**
 * crow — CLI for crow-code. Subcommands dispatch below.
 *   crow find-models   fetch model data and write .crow/models.json
 */
import { fileURLToPath } from 'node:url'
import path from 'node:path'
import { createRequire } from 'node:module'

const __dirname = path.dirname(fileURLToPath(import.meta.url))
const require = createRequire(path.join(__dirname, '..', 'package.json'))

const subcommand = process.argv[2]

if (subcommand === 'find-models') {
  const { gatherModelData } = require(
    path.join(
      __dirname,
      '..',
      'dist',
      'model-discovery',
      'gather-model-data.js',
    ),
  )
  gatherModelData().catch((error) => {
    console.error(error)
    process.exitCode = 1
  })
} else {
  console.error(
    `Usage: crow <subcommand>\n\nAvailable subcommands:\n  find-models   fetch model data and write .crow/models.json`,
  )
  process.exitCode = 1
}
