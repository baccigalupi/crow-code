#!/usr/bin/env bash
# Run the test suite with coverage. Any arguments are forwarded to deno test.
# Use --coverage-raw-data-only so Deno does not emit an unfiltered summary/lcov
# report; dev/coverage and agents/coverage-report generate the filtered reports.
set -euo pipefail

# --clean empties the coverage directory before collecting profiles so stale
# lcov/raw files do not accumulate across runs.
exec deno test --clean --coverage --coverage-raw-data-only --allow-env --allow-read --allow-write --allow-ffi --allow-run --allow-sys=hostname "$@"
