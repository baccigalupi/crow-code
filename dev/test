#!/usr/bin/env bash
# Run the test suite on bun:test. Any arguments are forwarded to bun test.
#
# bun test discovery skips dot directories, so the bare run passes
# ./tests/.claude explicitly to pick up the Claude hook tests. Paths into a dot
# directory need the ./ prefix, or bun treats them as name filters.
#
# Coverage comes from the bun preload (bunfig.toml), which needs bun test to
# run in a single process: never add --parallel.
set -euo pipefail

rm -rf coverage

if [[ $# -eq 0 ]]; then
  exec bun test ./tests ./tests/.claude
fi

exec bun test "$@"
