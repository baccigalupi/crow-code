#!/usr/bin/env bash
# Run the test suite. Tests run on bun:test, except the files below that
# exercise Deno-only code (style-check lint plugins and Devin hooks) until those
# move to Bun; those run on deno test. Any arguments are forwarded: paths in the
# Deno list go to deno test, everything else goes to bun test.
#
# bun test discovery skips dot directories, so the bare run passes
# ./tests/.claude explicitly to pick up the Claude hook tests. Paths into a dot
# directory need the ./ prefix, or bun treats them as name filters.
#
# Coverage comes from the bun preload (bunfig.toml), which needs bun test to
# run in a single process: never add --parallel.
set -euo pipefail

rm -rf coverage

deno_tests=(
  tests/agents/style-checks/code.test.ts
  tests/agents/style-checks/tsx.test.ts
  tests/agents/style-checks/unit-tests.test.ts
  tests/agents/style-checks/install-names.test.ts
  tests/agents/hooks/block-random-execs.test.ts
  tests/agents/hooks/stop-after-blocked-tool.test.ts
  tests/agents/hooks/dependency-lookup-context.test.ts
  tests/agents/hooks/recovery-state.test.ts
  tests/agents/hooks/stop-recovery.test.ts
)

is_deno_test() {
  local arg="${1%/}"
  local file
  for file in "${deno_tests[@]}"; do
    if [[ "$file" == "$arg" ]]; then
      return 0
    fi
  done
  return 1
}

run_deno() {
  # --no-check: Deno cannot type the Bun-native src these files reach;
  # agents/typecheck runs tsc, with agents/deno-types.d.ts supplying the Deno
  # types until the last Deno consumer is ported.
  deno test --no-check --allow-env --allow-read --allow-write --allow-ffi --allow-run --allow-sys=hostname "$@"
}

if [[ $# -eq 0 ]]; then
  run_deno "${deno_tests[@]}"
  exec bun test ./tests ./tests/.claude
fi

deno_args=()
bun_args=()
for arg in "$@"; do
  if is_deno_test "$arg"; then
    deno_args+=("$arg")
  else
    bun_args+=("$arg")
  fi
done

if [[ ${#deno_args[@]} -gt 0 ]]; then
  run_deno "${deno_args[@]}"
fi
if [[ ${#bun_args[@]} -gt 0 || ${#deno_args[@]} -eq 0 ]]; then
  exec bun test "${bun_args[@]}"
fi
