#!/usr/bin/env bash
# Dev-local helper: auto-fix lint and formatting, then typecheck via the agent gate.
# Formatting auto-fix is applied by Prettier (oxlint --fix only fixes lint rules).
set -euo pipefail

echo "--> Lint (auto-fix)"
node_modules/.bin/oxlint --fix

echo "--> Format (auto-fix)"
node_modules/.bin/prettier --write --log-level warn .

echo "--> Typecheck (TS issues)"
bash agents/typecheck
