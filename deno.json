{
  "name": "crow-code",
  "version": "0.0.1",
  "description": "task oriented coding agent",
  "exports": {
    ".": "./src/cli.ts"
  },
  "bin": {
    "crow": "bin/crow"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "@std/dotenv": "jsr:@std/dotenv@0.225.8",
    "@std/expect": "jsr:@std/expect@1.0.20",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/testing": "jsr:@std/testing@1.0.19",
    "ink": "npm:ink@7.1.1",
    "ink-testing-library": "npm:ink-testing-library@4.0.0",
    "react": "npm:react@19.3.0",
    "react/jsx-runtime": "npm:react@19.3.0/jsx-runtime",
    "@types/react": "npm:@types/react@19.2.14",
    "better-sqlite3": "npm:better-sqlite3@13.0.3",
    "knex": "npm:knex@3.3.0",
    "openai": "npm:openai@7.15.0",
    "pino": "npm:pino@10.3.1"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "exclude": [
    ".deps",
    ".worktrees"
  ]
}
