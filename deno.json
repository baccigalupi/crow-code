{
  "version": "0.0.1",
  "description": "task oriented coding agent",
  "bin": {
    "crow": "bin/crow"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "@preact/signals-core": "npm:@preact/signals-core@1.14.4",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/expect": "jsr:@std/expect@1.0.20",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/testing": "jsr:@std/testing@1.0.19",
    "ink": "npm:ink@7.1.1",
    "ink-testing-library": "npm:ink-testing-library@4.0.0",
    "react": "npm:react@19.3.0",
    "react/jsx-runtime": "npm:react@19.3.0/jsx-runtime",
    "@types/react": "npm:@types/react@19.2.14",
    "@types/picomatch": "npm:@types/picomatch@4.0.3",
    "dotenv": "npm:dotenv@18.0.8",
    "knex": "npm:knex@3.3.0",
    "openai": "npm:openai@7.15.0",
    "picomatch": "npm:picomatch@4.0.7",
    "pino": "npm:pino@10.3.1",
    "zod": "npm:zod@4.6.5"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "exclude": [
    ".deps",
    ".worktrees",
    ".claude/worktrees",
    "src/database/bun-sqlite-client.ts",
    "tests/database/bun-sqlite-client.test.ts",
    "tests/bun-compat",
    "agents/coverage/preload.ts",
    "tests/agents/coverage/preload.test.ts"
  ]
}
