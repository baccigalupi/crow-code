{
  "name": "crow-code",
  "version": "0.0.1",
  "description": "task oriented coding agent",
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-write",
    "typecheck": "deno check src bin tests agents",
    "diagnostics": "deno run --allow-run --allow-read --allow-env agents/editor-diagnostics.ts src bin tests",
    "format": "deno fmt",
    "format:check": "deno fmt --check"
  },
  "exports": {
    ".": "./src/cli.ts"
  },
  "bin": {
    "crow": "bin/crow.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@0.225.8",
    "@std/expect": "jsr:@std/expect@1.0.20",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/testing": "jsr:@std/testing@1.0.20"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  }
}
